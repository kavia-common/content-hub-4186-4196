# PUBLIC_INTERFACE
# Astro Blog Frontend UI - Environment Variables
# Copy this file to ".env" and fill in the values. Do not commit your .env file.

# PUBLIC_INTERFACE
# Base URL of the backend API (e.g., http://localhost:3001 or production API URL)
PUBLIC_BACKEND_API_BASE_URL="http://localhost:3001"

# PUBLIC_INTERFACE
# Site URL used for canonical links and SEO feeds. This will be used to generate sitemap.xml and rss.xml URLs.
# Set to your deployed domain (e.g., https://example.com)
PUBLIC_SITE_URL="http://localhost:3000"

# PUBLIC_INTERFACE
# Application display name and description (SEO defaults)
PUBLIC_SITE_NAME="Content Hub Blog"
PUBLIC_SITE_DESCRIPTION="A fast, SEO-optimized blog powered by Astro and a Node/Express API."

# PUBLIC_INTERFACE
# Storage key names for auth in localStorage. These must be consistent across the app.
PUBLIC_AUTH_TOKEN_STORAGE_KEY="blog_admin_jwt"
PUBLIC_AUTH_USER_STORAGE_KEY="blog_admin_user"

# PUBLIC_INTERFACE
# Optional: When logging in, some backends require specifying audience or client id.
# Not used here, but reserved for future compatibility.
PUBLIC_AUTH_AUDIENCE=""
PUBLIC_AUTH_CLIENT_ID=""
