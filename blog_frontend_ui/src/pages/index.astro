---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { listPosts } from '../lib/api';

const { searchParams } = Astro.url;
const q = searchParams.get('q') || '';
const tag = searchParams.get('tag') || '';
const category = searchParams.get('category') || '';

const rs = await listPosts({ q, tag, category, page: 1, limit: 20 });
const items = rs.ok && rs.data ? rs.data.items : [];
---

<Layout title="Latest Posts">
  <h1>Latest Posts</h1>

  <form class="filters" method="get">
    <input type="search" name="q" placeholder="Search posts..." value={q} />
    <input type="text" name="tag" placeholder="Filter by tag" value={tag} />
    <input type="text" name="category" placeholder="Filter by category" value={category} />
    <button type="submit">Apply</button>
    {(q || tag || category) && <a class="clear" href="/">Clear</a>}
  </form>

  {items.length === 0 && <p>No posts found.</p>}
  {items.map((post) => <PostCard post={post} />)}
</Layout>

<style>
.filters{
  display:flex;
  gap:8px;
  flex-wrap: wrap;
  margin: 16px 0 20px;
}
.filters input{
  border:1px solid var(--border-color);
  border-radius:8px; padding:8px 10px; background: var(--bg-color); color: var(--text-color);
}
.filters button{
  padding:8px 12px; border-radius:8px; border:1px solid var(--border-color); background: var(--card-bg); color: var(--text-color);
}
.filters .clear{ align-self:center; color: var(--text-secondary); text-decoration:none; }
.filters .clear:hover{ text-decoration: underline; }
</style>
